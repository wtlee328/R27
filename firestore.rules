rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
             (request.auth.token.role == 'admin' ||
              request.auth.token.admin == true ||
              (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    function isTrainer() {
      return isAuthenticated() &&
             (request.auth.token.role == 'trainer' ||
              (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'));
    }

    function hasAccess(centerId) {
      return isAdmin() || 
             (isTrainer() && 
              exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.centerId == centerId);
    }

    // Users collection
    match /users/{userId} {
      allow read, list: if isAuthenticated();
      // Users can only create their own document with default 'trainer' role, unless already admin
      allow create: if isAuthenticated() && request.auth.uid == userId &&
                      (!('role' in request.resource.data) || request.resource.data.role == 'trainer' || isAdmin());
      // Users cannot elevate their own role or isSuperAdmin status
      allow update: if isAdmin() ||
                      (isAuthenticated() && request.auth.uid == userId &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isSuperAdmin']));
      allow delete: if isAdmin();
    }

    // Trainers collection
    match /trainers/{trainerId} {
      allow read, list: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Customers
    match /customers/{customerId} {
      allow read, list: if isAuthenticated();
      allow create: if hasAccess(request.resource.data.centerId);
      allow update, delete: if hasAccess(resource.data.centerId);
    }

    // Contracts
    match /contracts/{contractId} {
      allow read, list: if isAuthenticated();
      allow create: if hasAccess(request.resource.data.centerId);
      allow update, delete: if hasAccess(resource.data.centerId);
    }

    // Lesson Records
    match /lessonRecords/{recordId} {
      allow read, list: if isAuthenticated();
      allow create: if hasAccess(request.resource.data.centerId);
      allow update, delete: if hasAccess(resource.data.centerId);
    }

    // Cash Flow Records
    match /cashFlowRecords/{recordId} {
      allow read, list: if isAuthenticated();
      allow create: if hasAccess(request.resource.data.centerId);
      allow update, delete: if hasAccess(resource.data.centerId);
    }

    // Trial Records
    match /trialRecords/{recordId} {
      allow read, list: if isAuthenticated();
      allow create: if hasAccess(request.resource.data.centerId);
      allow update, delete: if hasAccess(resource.data.centerId);
    }

    // Venue Rentals
    match /venueRentals/{rentalId} {
      allow read, list: if isAuthenticated();
      allow create: if hasAccess(request.resource.data.centerId);
      allow update, delete: if hasAccess(resource.data.centerId);
    }

    // Renter Customers
    match /renterCustomers/{customerId} {
      allow read, write, list: if isAuthenticated();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read, write, list: if isAuthenticated();
    }

    // System Config
    match /systemConfig/{docId} {
      allow read, list: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Activity Logs
    match /activityLogs/{logId} {
      allow read, list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // System Automated Backups
    match /systemBackups/{backupId}/{allPaths=**} {
      allow read, list, create, update: if isAdmin();
    }
  }
}
